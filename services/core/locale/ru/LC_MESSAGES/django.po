#: server/apps/accounts/templates/accounts/invitation.html
#: server/apps/accounts/templates/accounts/invitation_gone.html
msgid "Invitation"
msgstr "Приглашение"

#: server/apps/accounts/templates/accounts/invitation.html
#, python-format
msgid "Your account will be %(email)s. Choose a password for it."
msgstr "Ваша учётная запись: %(email)s. Выберите для неё пароль."

#: server/apps/accounts/templates/accounts/invitation.html
msgid "Rules of watching"
msgstr "Правила просмотра"

#: server/apps/accounts/templates/accounts/invitation.html
msgid ""
"The cameras show the common rooms of the home live. When you watch them, "
"never record the video, never take pictures of the screen and never pass the "
"video or your account to anyone."
msgstr "Камеры показывают общие комнаты дома в прямом эфире. Когда вы их смотрите, никогда не записывайте видео, не фотографируйте экран и никому не передавайте видео или свою учётную запись."

#: server/apps/accounts/templates/accounts/invitation.html
msgid "Create the account"
msgstr "Создать учётную запись"

#: server/apps/accounts/templates/accounts/invitation_gone.html
msgid "This link no longer works"
msgstr "Ссылка больше не действует"

#: server/apps/accounts/templates/accounts/invitation_gone.html
msgid ""
"The invitation was already used or has expired. Ask the staff of the home "
"for a new one."
msgstr "Приглашение уже использовано или истекло. Попросите персонал дома прислать новое."

#: server/apps/accounts/templates/accounts/password.html
