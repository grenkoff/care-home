msgstr "Исправьте поля ниже."

#: server/apps/enquiries/templates/enquiries/form.html
#: server/templates/site/layout.html server/templates/site/privacy.html
msgid "Privacy policy"
msgstr "Политика конфиденциальности"

#: server/apps/enquiries/templates/enquiries/form.html
msgid "Send"
msgstr "Отправить"

#: server/apps/enquiries/templates/enquiries/received.html
msgid "Enquiry received"
msgstr "Заявка получена"

#: server/apps/enquiries/templates/enquiries/received.html
msgid "Thank you"
msgstr "Спасибо"

#: server/apps/enquiries/templates/enquiries/received.html
msgid ""
"We have received your enquiry. We will call you back within a working day."
msgstr "Мы получили вашу заявку. Мы перезвоним вам в течение рабочего дня."

#: server/apps/enquiries/templates/enquiries/send.html
msgid "Enquiry"
msgstr "Заявка"

#: server/apps/enquiries/views/forms.py
msgid "Your name"
msgstr "Ваше имя"

#: server/apps/enquiries/views/forms.py
msgid "Message"
msgstr "Сообщение"

#: server/apps/enquiries/views/forms.py
msgid "I agree to the processing of my personal data"
msgstr "Даю согласие на обработку моих персональных данных"

#: server/apps/enquiries/views/pages.py
msgid "Enter a phone number, for example +7 495 123-45-67."
msgstr "Укажите номер телефона, например +7 495 123-45-67."

